# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Reddit (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=content-aggregator/0.1

# Twitter/X (https://developer.twitter.com)
TWITTER_BEARER_TOKEN=

# YouTube (https://console.cloud.google.com)
YOUTUBE_API_KEY=

# Newsletter IMAP inbox
NEWSLETTER_IMAP_HOST=
NEWSLETTER_IMAP_PORT=993
NEWSLETTER_IMAP_USER=
NEWSLETTER_IMAP_PASSWORD=

# Digest email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_FROM_EMAIL=digest@example.com
DIGEST_TO_EMAIL=you@example.com

# Slack digest
SLACK_WEBHOOK_URL=

# App settings
DATABASE_URL=sqlite+aiosqlite:///./aggregator.db
LOG_LEVEL=INFO
